# =====================================================================
#  Glovie website — Apache / cPanel / LiteSpeed configuration
# =====================================================================
Options -Indexes -MultiViews
ServerSignature Off
AddDefaultCharset UTF-8
DirectoryIndex index.html

# ---------- HTTPS + canonical host (www.glovie.net) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://www.glovie.net%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^glovie\.net$ [NC]
  RewriteRule ^ https://www.glovie.net%{REQUEST_URI} [L,R=301]

  # ---------- Block known scrapers / AI crawlers / scripted clients ----------
  RewriteCond %{HTTP_USER_AGENT} (GPTBot|ChatGPT-User|CCBot|ClaudeBot|anthropic-ai|Claude-Web|PerplexityBot|Bytespider|Amazonbot|Applebot-Extended|Google-Extended|meta-externalagent|FacebookBot|Diffbot|ImagesiftBot|Omgili|omgilibot|Timpibot|DataForSeoBot|PetalBot|MJ12bot|AhrefsBot|SemrushBot|DotBot|BLEXBot|Scrapy|python-requests|python-urllib|aiohttp|Go-http-client|okhttp|HeadlessChrome|PhantomJS|wget|libwww-perl|HTTrack|SiteSnagger|WebCopier|WebZIP|Teleport) [NC]
  RewriteRule ^ - [F,L]
  # Empty user agents are almost always scripts
  RewriteCond %{HTTP_USER_AGENT} ^-?$
  RewriteRule ^ - [F,L]

  # Never serve source/dev/hidden files
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(md|log|bak|sql|ini|sh|py|json\.dist|lock)$ - [F,L,NC]
</IfModule>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# ---------- Caching: versioned assets 1 year, HTML always revalidated ----------
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------- Compression ----------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

